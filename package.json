{
  "name": "@lamgc/playwright-mcp",
  "version": "0.0.79",
  "description": "LamGC Playwright BP tools for MCP",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LamGC/playwright-mcp.git"
  },
  "homepage": "https://github.com/LamGC/playwright-mcp",
  "engines": {
    "node": ">=18"
  },
  "author": {
    "name": "LamGC"
  },
  "license": "Apache-2.0",
  "mcpName": "io.github.lamgc/playwright-mcp",
  "scripts": {
    "lint": "node update-readme.js",
    "test": "node ./node_modules/@playwright/test/cli.js test",
    "ctest": "node ./node_modules/@playwright/test/cli.js test --project=chrome",
    "ftest": "node ./node_modules/@playwright/test/cli.js test --project=firefox",
    "wtest": "node ./node_modules/@playwright/test/cli.js test --project=webkit",
    "dtest": "MCP_IN_DOCKER=1 node ./node_modules/@playwright/test/cli.js test --project=chromium-docker",
    "build": "echo OK",
    "npm-publish": "npm run lint && npm run test && npm publish",
    "docker-build": "docker build --no-cache -t playwright-mcp-dev:latest .",
    "docker-rm": "docker rm playwright-mcp-dev",
    "docker-run": "docker run -it -p 8080:8080 --name playwright-mcp-dev playwright-mcp-dev:latest",
    "roll": "node roll.js"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "dependencies": {
    "@lamgc/playwright": "1.63.0-next.2",
    "@lamgc/playwright-core": "1.63.0-next.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@playwright/test": "1.63.0-alpha-2026-08-05",
    "@types/node": "^24.3.0"
  },
  "bin": {
    "playwright-mcp": "cli.js"
  }
}
